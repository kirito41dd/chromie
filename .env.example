# 复制为 .dev.env 后设置本地值，不提交真实凭据。
CHROMIE_MYSQL_PASSWORD=请设置开发数据库密码
CHROMIE_MYSQL_ROOT_PASSWORD=请设置开发数据库root密码
DATABASE_URL=mysql://chromie:请设置开发数据库密码@127.0.0.1:13306/chromie
CHROMIE_QDRANT_URL=http://127.0.0.1:16334
CHROMIE_QDRANT_API_KEY=请设置Qdrant访问密钥
CHROMIE_LISTEN=127.0.0.1:8732
# 仅新实例使用 init-key；这是 JWT 与 Secret 的根私钥，必须持久保存、独立备份。
# 已有实例禁止删除、重建或擅自替换；丢失后历史 Secret 无法恢复。重启读取原文件。
CHROMIE_KEY_FILE=.local/chromie-key.pem
# 默认读取仓库 web/pkg；部署时可指定已构建的固定资源目录。
# CHROMIE_WEB_DIR=/absolute/path/to/web/pkg
# 非回环部署时显式配置外部 Origin；支持 HTTP/HTTPS，TLS 由部署或网关负责。
# CHROMIE_PUBLIC_ORIGIN=https://chromie.example.com

# 以下供本地 hooks / MCP 客户端使用，不是服务端认证配置。
# CHROMIE_BIN=/absolute/path/to/chromie/target/debug/chromie
# CHROMIE_SECRET_HELPER=/absolute/path/to/chromie/examples/codex/secret-curl.py
# CHROMIE_URL=http://127.0.0.1:8732
# CHROMIE_SPACE=替换为空间标识
# CHROMIE_AGENT_ID=从Web接入页获取稳定AgentID
# CHROMIE_MCP_KEY=从Web接入页获取MCP密钥
# CHROMIE_HOOK_KEY=从Web接入页获取仅上传密钥
# CHROMIE_CLIENT_CONFIG=/absolute/path/to/private/chromie-client.json
# CHROMIE_QUEUE_DIR=/absolute/path/to/private/queue
# CHROMIE_PROJECT=chromie
# CHROMIE_CAPTURE=off
