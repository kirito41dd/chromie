import { SelectableText, SelectableArea } from "selectable-text.slint";
import { Theme, SecretBadge, EyeButton } from "common.slint";
import { MemoryFooter } from "memory-footer.slint";
import { RecallRow } from "recall-models.slint";

export component RecallResult inherits Rectangle {
    min-width: 0px; max-width: 100000px; preferred-width: 720px;
    horizontal-stretch: 1; vertical-stretch: 0;
    in property <RecallRow> memory;
    private property <bool> expanded: false;
    private property <string> expanded-key;
    out property <bool> details-open: root.expanded && root.expanded-key == root.memory.view-key;
    callback show-secret(string, string);
    callback toggle-details;
    toggle-details => { root.expanded = !root.details-open; root.expanded-key = root.memory.view-key; }
    out property <length> content-height: layout.preferred-height;
    height: layout.preferred-height;
    background: Theme.paper; border-radius: 14px;
    border-width: 1px; border-color: Theme.border;
    layout := VerticalLayout {
        padding: 20px; spacing: 14px;
        HorizontalLayout {
            height: root.memory.is-secret ? 44px : 24px; spacing: 10px; cross-axis-alignment: center;
            if root.memory.is-secret: SecretBadge {}
            if !root.memory.is-secret: SelectableText {
                min-width: 0px; horizontal-stretch: 1; text: root.memory.scope;
                text-color: #5747bd; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide;
            }
            if root.memory.is-secret: Rectangle { horizontal-stretch: 1; }
            if root.width >= 520px: SelectableText { text: root.memory.time; text-color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            if root.memory.is-secret: EyeButton { disabled: !root.memory.secret-stored || root.memory.memory-id == ""; activated => { root.show-secret(root.memory.memory-id, root.memory.content); } }
        }
        SelectableText { text: root.memory.content; text-color: Theme.ink; font-size: 15px; wrap: word-wrap; }
        if root.memory.is-secret: Rectangle {
            height: secret-info.preferred-height;
            background: #f0faf6; border-radius: 10px;
            secret-info := VerticalLayout {
                padding: 12px; spacing: 7px;
                SelectableText { text: root.memory.scope; text-color: Theme.secondary; font-size: 11px; }
                SelectableText {
                    text: root.memory.secret-status; font-size: 12px; font-weight: 600;
                    text-color: root.memory.secret-stored ? #087f69 : Theme.secondary;
                }
                Text { text: "点击眼睛查看 · 验证一次，5 分钟内免输"; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                if root.memory.secret-ref != "": SelectableText {
                    text: root.memory.secret-ref; font-size: 11px; text-color: Theme.secondary;
                    accessible-label: "Secret 引用";
                }
            }
        }
        MemoryFooter {
            agent-name: root.memory.agent-name; usage: root.memory.usage;
            pending: root.memory.pending; expanded: root.details-open;
            toggle-details => { root.toggle-details(); }
        }
        if root.details-open: VerticalLayout {
            spacing: 10px;
            SelectableText { text: "更新于 " + root.memory.time; text-color: Theme.muted; font-size: 11px; }
            if root.memory.usage-detail != "": SelectableText { text: root.memory.usage-detail; text-color: Theme.secondary; font-size: 11px; }
            if root.memory.web-usage != "": SelectableText { text: root.memory.web-usage; text-color: Theme.muted; font-size: 11px; }
            Rectangle { height: 1px; background: Theme.border; }
            Text { text: "记忆 ID"; color: Theme.muted; font-size: 11px; }
            SelectableArea { text: root.memory.memory-id;  height: 44px; font-size: 11px; wrap: word-wrap; }
            SelectableText { text: root.memory.detail; text-color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
            SelectableText { text: root.memory.path; text-color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
            SelectableText { text: root.memory.score; text-color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
        }
    }
}
