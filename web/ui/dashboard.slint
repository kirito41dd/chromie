    callback extraction-refresh;
    callback extraction-focus-close;
    extraction-focus-close => { extraction-reader.focus-close(); }

    in property <[KnowledgeRow]> knowledge-topics;
    in property <[KnowledgeRow]> knowledge-outgoing;
    in property <[KnowledgeRow]> knowledge-incoming;
    in property <bool> knowledge-open;
    in property <bool> knowledge-busy;
    in property <bool> knowledge-nav-busy;
    in property <bool> knowledge-back;
