import { ScrollView } from "std-widgets.slint";
import { Theme, ActionButton } from "common.slint";
import { SelectableText } from "selectable-text.slint";
export struct ExtractionJob { id: string, time: string, label: string }
component ExtractionJobRow inherits Rectangle {
    in property <ExtractionJob> item;
    callback activated;
    height: 64px; border-radius: 8px; background: touch.has-hover ? #f5f3fc : transparent;
    border-width: keyboard.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.item.time + " " + root.item.label;
    accessible-action-default => { root.activated(); }
    forward-focus: keyboard;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        VerticalLayout {
            alignment: center; spacing: 5px; horizontal-stretch: 1;
            Text { text: root.item.time; color: Theme.muted; font-size: 12px; overflow: elide; wrap: no-wrap; }
            Text { text: root.item.label; color: Theme.ink; font-size: 13px; overflow: elide; wrap: no-wrap; }
        }
        Text { text: "查看结果 ›"; color: Theme.accent; font-size: 12px; vertical-alignment: center; }
    }
    keyboard := FocusScope { focus-on-click: false; key-pressed(event) => { if !event.repeat && (event.text == Key.Return || event.text == " ") { root.activated(); accept } else { reject } } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}
export struct ExtractionDecision { index: int, action: string, reason: string, body: string, evidence: string, previous: string, proposed: string, can-apply: bool, applied: bool }
export component ExtractionResults inherits Rectangle {
    in property <[ExtractionJob]> jobs;
    callback open(string);
    private property <bool> expanded: false;
    height: layout.preferred-height;
    background: Theme.paper; border-radius: 12px; border-width: 1px; border-color: Theme.border;
    layout := VerticalLayout {
        padding: 18px; spacing: 10px;
        Text { text: "消息提炼结果"; color: Theme.ink; font-size: 16px; font-weight: 600; }
        SelectableText { text: "新结论自动保存；旧记忆的修订须在查看依据后确认。"; text-color: Theme.secondary; font-size: 12px; }
        for job[index] in root.jobs: ExtractionJobRow { visible: root.expanded || index < 3; item: job; height: self.visible ? 64px : 0px; activated => { root.open(job.id); } }
        if root.jobs.length > 3: ActionButton { label: root.expanded ? "收起记录" : "查看更多记录"; subtle: true; height: 36px; activated => { root.expanded = !root.expanded; } }
    }
}
export component ExtractionReader inherits Rectangle {
    in property <[ExtractionDecision]> decisions;
    in property <string> note;
    in property <string> error;
    in property <bool> busy;
    callback close;
    callback apply(int);
    callback refresh;
    callback focus-close;
    focus-close => { close-button.focus(); }
    background: #25254266;
    TouchArea { clicked => { root.close(); } }
    keyboard := FocusScope {
        width: root.width; height: root.height; focus-on-tab-navigation: false; focus-on-click: false;
        capture-key-pressed(event) => { if event.text == Key.Escape { root.close(); accept } else { reject } }
        panel := Rectangle {
            x: (root.width - self.width) / 2; y: 24px;
            width: min(920px, root.width - 24px); height: max(100px, root.height - 48px);
            border-radius: 14px; background: Theme.paper;
            TouchArea { clicked => {} }
            VerticalLayout {
                padding: parent.width < 500px ? 16px : 24px; spacing: 14px;
                HorizontalLayout {
                    height: 36px; spacing: 8px; cross-axis-alignment: center;
                    Text { text: "提炼结果与依据"; color: Theme.ink; font-size: 18px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: "刷新"; subtle: true; min-width: 56px; height: 36px; disabled: root.busy; activated => { root.refresh(); } }
                    close-button := ActionButton { label: "关闭"; subtle: true; min-width: 56px; height: 36px; activated => { root.close(); } }
                }
                SelectableText { text: root.note; text-color: Theme.secondary; font-size: 12px; }
                if root.error != "": SelectableText { text: root.error; text-color: #a13b33; font-size: 13px; }
                scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off; content-width: self.visible-width; vertical-stretch: 1;
                    VerticalLayout {
                        x: 0px; y: 0px; width: scroll.visible-width; height: self.preferred-height;
                        padding-right: 8px; padding-bottom: 20px; spacing: 20px; alignment: start;
                        if root.busy && root.decisions.length == 0: Text { text: "正在读取…"; color: Theme.muted; font-size: 13px; }
                        for row in root.decisions: Rectangle {
                            height: content.preferred-height; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                            content := VerticalLayout {
                                padding: 16px; spacing: 10px;
                                Text { text: row.action; color: row.can-apply ? Theme.accent : #138578; font-size: 14px; font-weight: 600; }
                                SelectableText { text: row.body; text-color: Theme.ink; font-size: 14px; }
                                SelectableText { text: row.reason; text-color: Theme.secondary; font-size: 13px; }
                                if row.previous != "": Text { text: "当前记忆"; color: Theme.secondary; font-size: 12px; font-weight: 600; }
                                if row.previous != "": SelectableText { text: row.previous; text-color: Theme.ink; font-size: 13px; }
                                if row.proposed != "": Text { text: "建议修订的完整正文"; color: Theme.accent; font-size: 12px; font-weight: 600; }
                                if row.proposed != "": SelectableText { text: row.proposed; text-color: Theme.ink; font-size: 13px; }
                                Text { text: "来源引文"; color: Theme.secondary; font-size: 12px; font-weight: 600; }
                                SelectableText { text: row.evidence; text-color: Theme.secondary; font-size: 12px; }
                                if row.can-apply: HorizontalLayout { alignment: start; ActionButton { label: "确认采用此修订"; min-width: 150px; height: 40px; disabled: root.busy; activated => { root.apply(row.index); } } }
                                if row.applied: Text { text: "已确认并生成新修订"; color: #138578; font-size: 12px; }
                            }
                        }
                    }
                }
            }
        }
        FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { close-button.focus(); } }
    }
}
