import { SelectableText, SelectableInput, PointerArea } from "selectable-text.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme, SecretBadge, InputField, ActionButton, EyeButton } from "common.slint";

export struct SecretLine { key: string, value: string, kind: int }

export component SecretContent inherits ScrollView {
    in property <string> value;
    in property <string> formatted-value;
    in property <[SecretLine]> lines;
    in property <bool> formatted;
    in property <bool> code;
    horizontal-scrollbar-policy: root.formatted ? as-needed : always-off;
    content-width: root.formatted ? max(self.visible-width, code-measure.preferred-width + 2px) : self.visible-width;
    // 同一字体度量下的整份只读选区覆盖着色层，跨字段和跨行不再中断。
    code-measure := Text {
        visible: false; text: root.formatted-value; font-size: 13px; wrap: no-wrap;
    }
    VerticalLayout {
        width: root.content-width; spacing: 0px;
        if root.formatted: Rectangle {
            height: root.lines.length * line-metrics.preferred-height + 4px;
            line-metrics := Text { visible: false; text: "M"; font-size: 13px; wrap: no-wrap; }
            VerticalLayout {
                alignment: start; spacing: 0px;
                for line in root.lines: Rectangle {
                    height: line-metrics.preferred-height;
                    key := Text {
                        x: 0px; y: 0px; width: self.preferred-width; height: parent.height;
                        text: line.key; color: #7651c4; font-size: 13px; wrap: no-wrap;
                    }
                    Text {
                        x: key.width; width: max(0px, parent.width - key.width); height: parent.height;
                        text: line.value;
                        color: line.kind == 1 ? #087f69 : (line.kind == 2 ? #a55c0b : (line.kind == 3 ? #426bc1 : Theme.secondary));
                        font-size: 13px; wrap: no-wrap;
                    }
                }
            }
            PointerArea {
              width: parent.width; height: parent.height; text-pointer: true;
              SelectableInput {
                width: parent.width; height: parent.height;
                text: root.formatted-value; font-size: 13px; wrap: no-wrap; single-line: false;
                // Femtovg 对全透明字色连选区背景也跳过；保留最小非零 alpha。
                text-color: #25254201; selection-foreground-color: #25254201;
                selection-background-color: #6d5ef744;
                accessible-label: "格式化的 Secret JSON";
              }
            }
        }
        if !root.formatted: Rectangle {
            height: max(24px, measure.preferred-height + 24px);
            measure := Text {
                width: parent.width; visible: false; text: root.value;
                font-size: 13px; wrap: word-wrap;
            }
            PointerArea {
              width: parent.width; height: parent.height; text-pointer: root.code;
              SelectableInput {
                width: parent.width; height: parent.height;
                text: root.value; read-only: true; single-line: false; wrap: word-wrap;
                text-color: Theme.ink; font-size: 13px; accessible-label: "Secret 原文";
              }
            }
        }
    }
}

export component SecretDialog inherits Rectangle {
    in property <string> label;
    in-out property <string> password;
    in property <string> value;
    in property <string> formatted-value;
    in property <[SecretLine]> lines;
    in property <bool> json;
    private property <bool> raw: false;
    changed revealed => { if !root.revealed { root.raw = false; } }
    in property <bool> revealed;
    in property <bool> verified;
    in property <bool> loading;
    in property <string> error;
    in property <string> copy-notice;
    callback copy(bool);
    private property <bool> needs-password: !root.revealed && !root.verified;
    callback close;
    callback toggle;
    callback focus-toggle;
    focus-toggle => { view-button.focus(); }
    callback focus-password;
    focus-password => { password-field.focus(); }
    forward-focus: keyboard;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <length> action-width: view-button.width;
    out property <length> action-top: view-button.y;
    background: #25254266;
    keyboard := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); accept }
            else if event.text == Key.Tab {
                if event.modifiers.shift {
                    if close-button.focused { view-button.focus(); }
                    else if root.needs-password && view-button.focused { password-field.focus(); }
                    else { close-button.focus(); }
                } else {
                    if root.needs-password && !password-field.focused && !view-button.focused { password-field.focus(); }
                    else if !view-button.focused { view-button.focus(); }
                    else { close-button.focus(); }
                }
                accept
            } else { reject }
        }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.close(); } }
        panel := Rectangle {
            width: min(760px, max(0px, root.width - 32px));
            height: min(max(0px, root.height - 32px), form.preferred-height);
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: Theme.paper; border-radius: 20px; border-width: 1px; border-color: #e8e5f4;
            clip: true;
            TouchArea { width: parent.width; height: parent.height; clicked => { } }
            scroll := ScrollView {
                width: parent.width; height: parent.height;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                form := VerticalLayout {
                    width: scroll.visible-width; padding: root.width < 360px ? 18px : 28px; spacing: 12px;
                    HorizontalLayout {
                        height: 36px; cross-axis-alignment: center;
                        SecretBadge {}
                        Rectangle { horizontal-stretch: 1; }
                        close-button := ActionButton { label: "关闭"; subtle: true; min-width: 64px; height: 36px; activated => { root.close(); } }
                    }
                    SelectableText { text: root.label; text-color: Theme.ink; font-size: 19px; font-weight: 600; wrap: word-wrap; }
                    HorizontalLayout {
                        height: 18px; spacing: 7px; cross-axis-alignment: center;
                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.verified ? Theme.green : #b1afc3; }
                        Text { min-width: 0px; horizontal-stretch: 1; text: root.verified ? "已验证 · 5 分钟内免输密码" : "验证空间密码后可查看"; color: root.verified ? #087f69 : Theme.secondary; font-size: 11px; overflow: elide; }
                    }
                    Rectangle {
                        height: root.revealed ? min(420px, max(180px, root.height * 0.45)) : 140px; background: #f7f6fc; border-radius: 12px; border-width: 1px; border-color: #eeecf6;
                        if !root.revealed: VerticalLayout {
                            padding: 20px; spacing: 6px; alignment: center;
                            Text { text: "••••  ••••  ••••"; color: #8b85ad; font-size: 24px; }
                            Text { text: "原文已隐藏"; color: Theme.muted; font-size: 11px; }
                        }
                        if root.revealed: VerticalLayout {
                            padding: 12px; spacing: 6px;
                            HorizontalLayout {
                                height: 28px; cross-axis-alignment: center;
                                Text { text: root.json && !root.raw ? "JSON" : "原文"; color: Theme.muted; font-size: 11px; }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton { label: "复制全部"; subtle: true; height: 28px; activated => { root.copy(root.json && !root.raw); } }
                                mode-button := ActionButton {
                                    visible: root.json;
                                    label: root.raw ? "格式化" : "查看原文"; subtle: true; height: 28px;
                                    activated => { root.raw = !root.raw; }
                                }
                            }
                            SecretContent {
                                value: root.value; formatted-value: root.formatted-value; lines: root.lines; formatted: root.json && !root.raw; code: root.json;
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: root.needs-password ? 8px : 0px;
                        Text { visible: root.needs-password; height: root.needs-password ? 18px : 0px; text: "空间密码"; color: Theme.ink; font-size: 12px; font-weight: 600; }
                        password-field := InputField {
                            visible: root.needs-password; height: root.needs-password ? 48px : 0px;
                            value <=> root.password; hint: "输入当前空间密码"; masked: true; disabled: root.loading;
                            accepted => { if !root.loading { root.toggle(); } }
                        }
                        SelectableText { height: 32px; text: root.error != "" ? root.error : root.copy-notice; text-color: root.error != "" ? #a13b33 : Theme.secondary; font-size: 12px; wrap: word-wrap; }
                    }
                    view-button := EyeButton {
                        revealed: root.revealed; disabled: root.loading;
                        caption: root.loading ? "验证中…" : (root.revealed ? "隐藏原文" : (root.verified ? "显示原文" : "验证并显示"));
                        label: root.revealed ? "隐藏 Secret" : (root.verified ? "显示 Secret" : "验证密码并显示 Secret");
                        activated => { root.toggle(); }
                    }
                    Text { text: "原文显示 60 秒后自动隐藏"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                }
            }
        }
    }
}
