import { SelectableText, SelectableArea } from "selectable-text.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, ActionButton, InputField } from "common.slint";

export struct ConversationRow { title: string, preview: string, meta: string }
export struct CapturedRow { id: string, role: string, user: bool, body: string, time: string, metadata: string, truncated: bool }

component ConversationCard inherits Rectangle {
    in property <ConversationRow> item;
    in property <bool> selected;
    in property <bool> disabled;
    callback activated;
    height: content.preferred-height;
    background: root.selected ? Theme.accent-soft : (touch.has-hover ? Theme.surface-hover : Theme.paper);
    border-radius: 9px; border-width: 1px;
    border-color: root.selected || keyboard.has-focus ? Theme.accent : transparent;
    accessible-role: button; accessible-label: root.item.title;
    accessible-action-default => { if !root.disabled { root.activated(); } }
    forward-focus: keyboard;
    content := VerticalLayout {
        padding: 14px; spacing: 7px; alignment: start;
        Text { text: root.item.title; color: Theme.ink; font-size: 13px; font-weight: 600; overflow: elide; wrap: no-wrap; height: 20px; }
        Text { text: root.item.preview; color: Theme.secondary; font-size: 12px; wrap: word-wrap; height: 36px; overflow: elide; }
        Text { text: root.item.meta; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
    }
    keyboard := FocusScope {
        enabled: !root.disabled; focus-on-click: false;
        key-pressed(event) => {
            if !event.repeat && (event.text == Key.Return || event.text == " ") { root.activated(); accept } else { reject }
        }
    }
    touch := TouchArea { enabled: !root.disabled; mouse-cursor: pointer; clicked => { keyboard.focus(); root.activated(); } }
}

component SessionPane inherits Rectangle {
    in property <bool> busy;
    in property <[ConversationRow]> sessions;
    in property <int> selected;
    in property <int> page;
    in property <bool> more;
    callback select(int);
    callback turn(int);
    min-width: 0px;
    background: Theme.paper; border-radius: 12px; border-width: 1px; border-color: Theme.border;
    VerticalLayout {
        padding: 10px; spacing: 8px;
        HorizontalLayout {
            padding-left: 6px; padding-right: 6px; height: 32px; cross-axis-alignment: center;
            Text { text: "会话"; color: Theme.ink; font-size: 14px; font-weight: 600; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.busy ? "读取中…" : "本页 " + root.sessions.length + " 个"; color: Theme.muted; font-size: 11px; }
        }
        list-scroll := ScrollView {
            horizontal-scrollbar-policy: always-off; content-width: self.visible-width; vertical-stretch: 1;
            VerticalLayout {
                x: 0px; y: 0px; width: list-scroll.visible-width; height: self.preferred-height; alignment: start; spacing: 6px; padding-right: 4px;
                if root.sessions.length == 0: Rectangle {
                    height: 160px;
                    Text { text: root.busy ? "正在读取会话…" : "暂无采集消息\n接入 Agent 并启用 Hook 后，消息会出现在这里"; color: Theme.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                }
                for session[index] in root.sessions: ConversationCard {
                    item: session; selected: root.selected == index; disabled: root.busy;
                    activated => { root.select(index); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            height: 38px; spacing: 6px; cross-axis-alignment: center;
            ActionButton { label: "上一页"; min-width: 66px; height: 32px; subtle: true; disabled: root.busy || root.page == 0; activated => { root.turn(-1); list-scroll.content-y = 0px; } }
            Text { text: "第 " + (root.page + 1) + " 页"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; horizontal-stretch: 1; }
            ActionButton { label: "下一页"; min-width: 66px; height: 32px; subtle: true; disabled: root.busy || !root.more; activated => { root.turn(1); list-scroll.content-y = 0px; } }
        }
    }
}

component ThreadPane inherits Rectangle {
    in property <bool> compact;
    in property <bool> busy;
    in property <bool> selected;
    in property <string> title;
    in property <string> info;
    in property <string> history;
    in property <bool> title-locked;
    in-out property <string> title-draft;
    in property <[CapturedRow]> messages;
    in property <int> page;
    in property <bool> more;
    in property <string> expanded;
    in property <string> full-body;
    in property <string> full-note;
    in property <bool> extract-enabled;
    in property <bool> extract-busy;
    in property <string> extract-note;
    in property <string> extract-error;
    private property <bool> more-open;
    private property <bool> editing-title;
    private property <bool> show-history;
    private property <string> debug-id;
    changed title => { root.debug-id = ""; root.editing-title = false; root.show-history = false; root.more-open = false; }
    changed page => { root.debug-id = ""; }
    callback reset-scroll;
    reset-scroll => { message-scroll.content-y = 0px; }
    callback save-title(bool);
    callback back;
    callback turn(int);
    callback expand(string);
    callback extract;
    min-width: 0px; horizontal-stretch: 1;
    background: Theme.paper; border-radius: 12px; border-width: 1px; border-color: Theme.border;
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: heading.preferred-height;
            heading := VerticalLayout {
                padding: root.compact ? 14px : 20px; spacing: 8px; alignment: start;
                HorizontalLayout {
                    spacing: 8px; cross-axis-alignment: center;
                    if root.compact && root.selected: ActionButton { label: "‹ 会话"; min-width: 64px; height: 32px; subtle: true; activated => { root.back(); } }
                    Text { text: root.selected ? root.title : "消息正文"; color: Theme.ink; font-size: 14px; font-weight: 600; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; min-width: 0px; }
                    if root.selected: ActionButton {
                        label: root.more-open ? "收起操作" : "更多操作"; min-width: 76px; height: 32px; subtle: true;
                        activated => { root.more-open = !root.more-open; if root.more-open { root.reset-scroll(); } }
                    }
                }
                if root.selected: Text { text: root.busy ? "正在读取消息…" : "第 " + (root.page + 1) + " 页 · 从旧到新排列 · 第 1 页为最近消息"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        message-scroll := ScrollView {
            horizontal-scrollbar-policy: always-off; content-width: self.visible-width; vertical-stretch: 1;
            VerticalLayout {
                x: 0px; y: 0px; width: message-scroll.visible-width; height: self.preferred-height;
                padding: root.compact ? 14px : 20px; spacing: 16px; alignment: start;
                if !root.selected: Rectangle {
                    height: 230px;
                    VerticalLayout { alignment: center; spacing: 10px;
                        Text { text: "选择一个会话"; color: Theme.ink; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: "查看采集到的用户消息与助手回复"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }
                if root.selected && root.more-open: Rectangle {
                    height: tools.preferred-height; background: Theme.surface-hover; border-radius: 9px;
                    tools := VerticalLayout {
                        padding: 14px; spacing: 10px; alignment: start;
                        SelectableText { text: root.info; text-color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 8px; alignment: start;
                            ActionButton { label: root.editing-title ? "取消命名" : "固定标题"; height: 32px; min-width: 76px; subtle: true; disabled: root.busy; activated => { root.editing-title = !root.editing-title; } }
                            if root.title-locked: ActionButton { label: "恢复自动"; height: 32px; min-width: 76px; subtle: true; disabled: root.busy; activated => { root.save-title(false); } }
                            if root.history != "": ActionButton { label: root.show-history ? "收起历史" : "标题历史"; height: 32px; min-width: 76px; subtle: true; activated => { root.show-history = !root.show-history; } }
                        }
                        if root.editing-title: VerticalLayout { spacing: 8px;
                            InputField { value <=> root.title-draft; hint: "输入简短标题"; disabled: root.busy; }
                            HorizontalLayout { alignment: start;
                                ActionButton { label: "保存标题"; min-width: 86px; height: 34px; disabled: root.busy || root.title-draft == ""; activated => { root.save-title(true); root.editing-title = false; } }
                            }
                        }
                        if root.show-history: SelectableText { text: root.history; text-color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                        if root.extract-enabled: VerticalLayout { spacing: 8px;
                            Text { text: "手动提炼会将本页前 10 条消息发送给已配置的文本模型，可能包含敏感内容。"; color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout { alignment: start;
                                ActionButton { label: root.extract-busy ? "正在提炼…" : "提炼本页消息"; height: 34px; min-width: 112px; subtle: true; disabled: root.extract-busy || root.busy || root.messages.length == 0; activated => { root.extract(); } }
                            }
                        }
                        if root.extract-error != "": SelectableText { text: root.extract-error; text-color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                        if root.extract-note != "": SelectableText { text: root.extract-note; text-color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                    }
                }
                if root.selected && root.messages.length == 0: Rectangle {
                    height: 140px;
                    Text { text: root.busy ? "正在读取消息…" : "此会话暂无可显示的消息"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
                for message in root.messages: Rectangle {
                    min-width: 0px; height: card.preferred-height;
                    card := VerticalLayout { spacing: 10px; alignment: start;
                        HorizontalLayout { spacing: 8px; height: 22px; cross-axis-alignment: center;
                            Rectangle { width: 3px; height: 14px; border-radius: 2px; background: message.user ? Theme.accent : Theme.green; }
                            Text { text: message.role; color: message.user ? Theme.accent : Theme.green; font-size: 12px; font-weight: 600; }
                            Rectangle { horizontal-stretch: 1; }
                            SelectableText { text: message.time; text-color: Theme.muted; font-size: 11px; }
                        }
                        if root.expanded != message.id: SelectableText { text: message.body; text-color: Theme.ink; font-size: 14px; wrap: word-wrap; }
                        if root.expanded == message.id: SelectableArea { text: root.full-body; wrap: word-wrap; font-size: 14px; height: 320px; min-width: 0px; }
                        if root.expanded == message.id && root.full-note != "": SelectableText { text: root.full-note; text-color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 8px; alignment: start;
                            if message.truncated: ActionButton { label: root.expanded == message.id ? "收起正文" : "完整正文"; min-width: 76px; height: 30px; subtle: true; disabled: root.busy; activated => { root.expand(message.id); } }
                            ActionButton { label: root.debug-id == message.id ? "收起详情" : "采集详情"; min-width: 76px; height: 30px; subtle: true; activated => { root.debug-id = root.debug-id == message.id ? "" : message.id; } }
                        }
                        if root.debug-id == message.id: SelectableArea { text: message.metadata; code: true; wrap: word-wrap; font-size: 11px; height: 160px; min-width: 0px; }
                        Rectangle { height: 1px; background: Theme.border; }
                    }
                }
            }
        }
        if root.selected: Rectangle { height: 1px; background: Theme.border; }
        if root.selected: HorizontalLayout {
            padding: 12px; spacing: 8px; alignment: start;
            ActionButton { label: "更早消息"; min-width: 88px; height: 34px; subtle: true; disabled: root.busy || !root.more; activated => { root.turn(1); } }
            ActionButton { label: "较新消息"; min-width: 88px; height: 34px; subtle: true; disabled: root.busy || root.page == 0; activated => { root.turn(-1); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component MessagesPage inherits Rectangle {
    in property <bool> compact;
    in property <bool> wide;
    in property <bool> busy;
    in property <string> error;
    in property <[string]> agents;
    in property <int> agent-index;
    in property <[ConversationRow]> sessions;
    in property <int> selected: -1;
    in property <int> session-page;
    in property <bool> sessions-more;
    in property <string> thread-title;
    in property <string> thread-info;
    in property <string> title-history;
    in property <bool> title-locked;
    in-out property <string> title-draft;
    in property <[CapturedRow]> messages;
    in property <int> message-page;
    in property <bool> messages-more;
    in property <string> expanded;
    in property <string> full-body;
    in property <string> full-note;
    in property <bool> extract-enabled;
    in property <bool> extract-busy;
    in property <string> extract-note;
    in property <string> extract-error;
    callback save-title(bool);
    callback refresh;
    callback filter(int);
    callback select(int);
    callback turn-sessions(int);
    callback turn-messages(int);
    callback expand(string);
    callback extract;
    in property <int> scroll-reset;
    changed scroll-reset => { thread.reset-scroll(); }
    min-width: 0px;
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            height: 42px; spacing: 10px; cross-axis-alignment: center;
            ComboBox { model: root.agents; current-index: root.agent-index; width: root.compact ? min(160px, root.width - 90px) : 220px; enabled: !root.busy; selected(value) => { root.filter(self.current-index); } }
            Rectangle { horizontal-stretch: 1; }
            if !root.compact: Text { text: "原始消息 · 不参与直接召回"; color: Theme.muted; font-size: 12px; }
            ActionButton { label: root.busy ? "读取中…" : "刷新"; min-width: 72px; height: 36px; subtle: true; disabled: root.busy; activated => { root.refresh(); } }
        }
        if root.error != "": Rectangle {
            height: max(48px, error-label.preferred-height + 24px); border-radius: 8px; background: Theme.danger-soft;
            error-label := SelectableText { x: 12px; width: parent.width - 24px; y: 12px; text: root.error; text-color: Theme.danger; font-size: 12px; wrap: word-wrap; }
        }
        HorizontalLayout {
            spacing: root.wide ? 18px : 0px; vertical-stretch: 1;
            // 保持面板实例：窄屏隐藏列表时不销毁，返回后沿用列表滚动位置。
            SessionPane {
                visible: root.wide || root.selected < 0; width: !self.visible ? 0px : root.wide ? 300px : parent.width;
                busy: root.busy; sessions: root.sessions; selected: root.selected; page: root.session-page; more: root.sessions-more;
                select(index) => { root.select(index); } turn(direction) => { root.turn-sessions(direction); }
            }
            thread := ThreadPane {
                visible: root.wide || root.selected >= 0; width: self.visible ? (root.wide ? parent.width - 318px : parent.width) : 0px;
                compact: !root.wide; busy: root.busy; selected: root.selected >= 0;
                title: root.thread-title; info: root.thread-info; history: root.title-history; title-locked: root.title-locked;
                title-draft <=> root.title-draft; messages: root.messages; page: root.message-page; more: root.messages-more;
                expanded: root.expanded; full-body: root.full-body; full-note: root.full-note;
                extract-enabled: root.extract-enabled; extract-busy: root.extract-busy; extract-note: root.extract-note; extract-error: root.extract-error;
                save-title(fixed) => { root.save-title(fixed); } back => { root.select(-1); }
                turn(direction) => { root.turn-messages(direction); } expand(id) => { root.expand(id); } extract => { root.extract(); }
            }
        }
    }
}
